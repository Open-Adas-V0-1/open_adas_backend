# ══════════════ App ══════════════
APP_NAME="Open_Adas"
APP_VERSION="0.1"

# ══════════════ Database (Postgres) ══════════════
DB_HOST=localhost
DB_PORT=5432
DB_NAME=open_adas
DB_USER=open_adas
DB_PASSWORD=changeme

# ══════════════ Object storage (MinIO / S3-compatible) ══════════════
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET=open-adas
MINIO_SECURE=false

# ══════════════ LLM (added in T3, placeholders only) ══════════════

# Fournisseur LLM par défaut : gpt | ollama | gemini | claude | capgemini
LLM_BACKEND=capgemini
# Identifiant du modèle à utiliser (ex : anthropic.claude-sonnet-5)
LLM_MODEL_ID=
# Clé API générique utilisée par le fournisseur ci-dessus
LLM_API_KEY=
# URL de base utilisée par les fournisseurs compatibles OpenAI (gpt, ollama, capgemini)
LLM_BASE_URL=

# Surcharge par nœud/agent (optionnel) — remplace LLM_BACKEND / LLM_MODEL_ID
# pour un nœud précis. Remplacer {NODE} par le nom du nœud en majuscules.
# LLM_OVERRIDE_{NODE}_BACKEND=
# LLM_OVERRIDE_{NODE}_MODEL_ID=

# Clé API Capgemini Generative Engine (si LLM_BACKEND=capgemini)
CAPGEMINI_API_KEY=
# URL de base du Capgemini Generative Engine (compatible OpenAI)
CAPGEMINI_BASE_URL=https://openai.generative.engine.capgemini.com/v1

# Clé API Google Gemini (si LLM_BACKEND=gemini, sinon LLM_API_KEY est utilisée)
GEMINI_API_KEY=
# Clé API Anthropic/Claude (si LLM_BACKEND=claude, sinon LLM_API_KEY est utilisée)
ANTHROPIC_API_KEY=

# Active ou désactive la politique de nouvelle tentative (retry) sur les appels LLM
LLM_RETRY_ENABLED=true
# Nombre maximal de tentatives avant abandon
LLM_RETRY_MAX_ATTEMPTS=3
# Délai initial (en secondes) avant la première nouvelle tentative
LLM_RETRY_INITIAL_WAIT=1.0
# Délai maximal (en secondes) entre deux tentatives
LLM_RETRY_MAX_WAIT=30.0
# Facteur de dispersion aléatoire (jitter, en secondes) ajouté au délai d'attente
LLM_RETRY_JITTER=1.0
# Délai maximal (en secondes) accordé à un appel LLM avant expiration
LLM_TIMEOUT=60.0

# Niveau de log applicatif : DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Sortie des logs au format JSON (true) ou lisible en console (false)
LOG_JSON=false

# ══════════════ SysML — garde-fous de la couche intermédiaire (T5) ══════════════
# Nombre maximal d'exécutions du superviseur intermédiaire dans un seul cycle
SYSML_MIDDLE_MAX_VISITS=10
# Limite globale d'étapes pour le sous-graphe intermédiaire (garde anti-boucle infinie)
SYSML_MIDDLE_RECURSION_LIMIT=25

# ══════════════ Superviseur de haut niveau — garde-fous (T6) ══════════════
# Nombre maximal d'exécutions du superviseur de haut niveau dans un seul tour
SUPERVISOR_MAX_VISITS=10
# Limite globale d'étapes pour le graphe superviseur (garde anti-boucle infinie)
SUPERVISOR_RECURSION_LIMIT=25

# ══════════════ Checkpointer de production (T6) ══════════════
# Clé de chiffrement AES des checkpoints au repos (16, 24 ou 32 caractères EXACTEMENT).
# Ne jamais coder cette valeur en dur ; générer une clé aléatoire par environnement.
CHECKPOINT_ENCRYPTION_KEY=
# Mode de durabilité du checkpointer : sync | async | exit
CHECKPOINT_DURABILITY=async

# ══════════════ SysML — couche de traitement unique (Layer 3) ══════════════
# Nombre maximal de cycles génération/vérification dans une seule boucle de traitement
SYSML_PROC_MAX_VISITS=5
# Limite globale d'étapes pour le sous-graphe de traitement unique (garde anti-boucle infinie)
SYSML_PROC_RECURSION_LIMIT=25

# ══════════════ Outillage SysML v2 (daltskin/sysml-v2-lsp) ══════════════
# Commande Node.js utilisée pour lancer les serveurs LSP/MCP
SYSML_NODE_BIN=node
# Chemin vers le serveur LSP (validation). Laisser vide pour utiliser le chemin par
# défaut : tools/sysml_v2/node_modules/sysml-v2-lsp/dist/server/server.js
SYSML_LSP_SERVER_PATH=
# Chemin vers le serveur MCP (diagramme Mermaid). Laisser vide pour utiliser le chemin
# par défaut : tools/sysml_v2/node_modules/sysml-v2-lsp/dist/server/mcpServer.js
SYSML_MCP_SERVER_PATH=
# Délai maximal (en secondes) accordé à un appel de l'outillage SysML v2
SYSML_TOOLING_TIMEOUT=30.0

# ══════════════ Duree de vie des threads de traitement SysML (Layer 2) ══════════════
# Duree de vie (en jours) de l'etat de traitement d'un thread SysML inactif avant expiration
# (les artefacts approuves en base ne sont JAMAIS supprimes ; seule la capacite de time-travel est perdue)
SYSML_THREAD_TTL_DAYS=30
